EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Injected into the Android Maps SDK config by app.config.js (see there) -
# app.json intentionally leaves that field blank so the key is never committed.
# Restrict in Google Cloud Console to: API = "Maps SDK for Android" only;
# Application = Android apps (package name + SHA-1 cert fingerprint).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
