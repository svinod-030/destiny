EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Injected into the Android Maps SDK config by app.config.js (see there) -
# app.json intentionally leaves that field blank so the key is never committed.
# Restrict in Google Cloud Console to: API = "Maps SDK for Android" only;
# Application = Android apps (package name + SHA-1 cert fingerprint).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# AdMob. Leave blank to build with Google's public test app/ad-unit IDs
# (app.config.js and AdBanner.tsx both fall back to those automatically).
# Fill in once a real AdMob account/app exists. Ads only render at all when
# the config/features Firestore doc has adsEnabled: true (see AdBanner.tsx).
# Ads - Android
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=

# Ads - ios
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=
